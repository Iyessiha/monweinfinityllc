# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (contact form → monweci@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=monweci@gmail.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=monweci@gmail.com

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://monweinfinity.com

# Infinity Pay (futur)
INFINITYPAY_WEBHOOK_SECRET=change_me
